[Unit]
Description=OpenCode Telegram Assistant Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/opencode-telebridge
ExecStart=/usr/bin/python3 %h/opencode-telebridge/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.opencode/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
