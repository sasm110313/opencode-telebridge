# ==========================================
# OpenCode Telegram Assistant Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather
# Example: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Allowed Telegram User IDs (Comma-separated numbers)
# Obtain your numeric ID by messaging @userinfobot or @get_id_bot on Telegram
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USERS=YOUR_TELEGRAM_USER_ID

# 3. OpenCode Server Settings
# If OpenCode serve is running or auto-started
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_AUTO_START=true

# The command to execute OpenCode (e.g. 'opencode' or '/path/to/opencode' or 'npx opencode')
OPENCODE_COMMAND=opencode

# Working directory for OpenCode workspace (defaults to current repository folder if left empty)
OPENCODE_WORKSPACE_DIR=

# Optional Server Password if configured in OpenCode
OPENCODE_SERVER_PASSWORD=

# 4. Proxy Configuration (If Telegram is filtered/blocked in your network)
# Supports HTTP/HTTPS proxies (e.g., V2Ray / Clash / Sing-box HTTP port)
# Example: http://127.0.0.1:10809 or http://127.0.0.1:2080
# TELEGRAM_PROXY=http://127.0.0.1:10809

# 5. UI Streaming Settings
# Throttle in milliseconds for message edits (lower = faster updates, 400-500ms prevents Telegram 429)
STREAM_THROTTLE_MS=450

# 6. Bale Messenger Settings (Optional - if using bale_bot.py)
# Bot token obtained from @BotFather in Bale messenger
# BALE_BOT_TOKEN=YOUR_BALE_BOT_TOKEN_HERE
# BALE_ALLOWED_USERS=YOUR_BALE_USER_ID
# BALE_API_BASE_URL=https://tapi.bale.ai
# BALE_STREAM_THROTTLE_MS=2200
# BALE_PROXY=

